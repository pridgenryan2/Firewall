#!name=Apple-Only Firewall
#!desc=Allow only Apple-owned domains and block everything else.
#!system=ios
#!author=Codex

[Proxy Group]
subnet-apple = subnet, default = DIRECT, hidden = true

[Rule]
DOMAIN-SUFFIX,apple.com,subnet-apple
DOMAIN-SUFFIX,apple.com.cn,subnet-apple
DOMAIN-SUFFIX,icloud.com,subnet-apple
DOMAIN-SUFFIX,icloud-content.com,subnet-apple
DOMAIN-SUFFIX,me.com,subnet-apple
DOMAIN-SUFFIX,mac.com,subnet-apple
DOMAIN-SUFFIX,itunes.com,subnet-apple
DOMAIN-SUFFIX,applemusic.com,subnet-apple
DOMAIN-SUFFIX,mzstatic.com,subnet-apple
DOMAIN-SUFFIX,apple-cloudkit.com,subnet-apple
DOMAIN-SUFFIX,apple-dns.net,subnet-apple
DOMAIN-SUFFIX,apple-mapkit.com,subnet-apple
DOMAIN-SUFFIX,aaplimg.com,subnet-apple
DOMAIN-SUFFIX,cdn-apple.com,subnet-apple
DOMAIN-SUFFIX,apple.news,subnet-apple
DOMAIN-SUFFIX,appstore.com,subnet-apple
