#!name=Microsoft Public Firewall
#!desc=Allow major Microsoft services and cloud platforms; excludes user-hosted endpoints.
#!system=ios
#!author=Codex

[Proxy Group]
subnet-microsoft = subnet, default = DIRECT, hidden = true

[Rule]
DOMAIN,account.microsoft.com,subnet-microsoft
DOMAIN,login.microsoftonline.com,subnet-microsoft
DOMAIN,login.microsoft.com,subnet-microsoft
DOMAIN,login.windows.net,subnet-microsoft
DOMAIN,device.login.microsoftonline.com,subnet-microsoft
DOMAIN,login.live.com,subnet-microsoft
DOMAIN-SUFFIX,microsoftonline.com,subnet-microsoft
DOMAIN-SUFFIX,msauth.net,subnet-microsoft
DOMAIN-SUFFIX,msauthimages.net,subnet-microsoft
DOMAIN-SUFFIX,msftauth.net,subnet-microsoft
DOMAIN-SUFFIX,msftauthimages.net,subnet-microsoft
DOMAIN-SUFFIX,aadcdn.microsoftonline-p.com,subnet-microsoft
DOMAIN-SUFFIX,microsoft.com,subnet-microsoft
DOMAIN-SUFFIX,windows.com,subnet-microsoft
DOMAIN-SUFFIX,office.com,subnet-microsoft
DOMAIN-SUFFIX,office365.com,subnet-microsoft
DOMAIN-SUFFIX,outlook.com,subnet-microsoft
DOMAIN-SUFFIX,live.com,subnet-microsoft
DOMAIN-SUFFIX,microsoftstore.com,subnet-microsoft
DOMAIN-SUFFIX,skype.com,subnet-microsoft
DOMAIN-SUFFIX,xbox.com,subnet-microsoft
DOMAIN-SUFFIX,xboxlive.com,subnet-microsoft
DOMAIN-SUFFIX,bing.com,subnet-microsoft
DOMAIN-SUFFIX,bing.net,subnet-microsoft
DOMAIN-SUFFIX,msn.com,subnet-microsoft
DOMAIN-SUFFIX,surface.com,subnet-microsoft
DOMAIN,docs.microsoft.com,subnet-microsoft
DOMAIN,learn.microsoft.com,subnet-microsoft
DOMAIN,manage.microsoft.com,subnet-microsoft
DOMAIN,portal.manage.microsoft.com,subnet-microsoft
DOMAIN,enrollment.manage.microsoft.com,subnet-microsoft
DOMAIN,enterpriseenrollment.manage.microsoft.com,subnet-microsoft
DOMAIN-SUFFIX,enterpriseregistration.windows.net,subnet-microsoft
DOMAIN,support.microsoft.com,subnet-microsoft
DOMAIN-SUFFIX,windowsupdate.com,subnet-microsoft
DOMAIN,update.microsoft.com,subnet-microsoft
DOMAIN-SUFFIX,microsoftupdate.com,subnet-microsoft
DOMAIN,download.microsoft.com,subnet-microsoft
DOMAIN,download.windowsupdate.com,subnet-microsoft
DOMAIN,officecdn.microsoft.com,subnet-microsoft
DOMAIN-SUFFIX,azure.com,subnet-microsoft
DOMAIN,portal.azure.com,subnet-microsoft
DOMAIN,reactblade.portal.azure.net,subnet-microsoft
DOMAIN-SUFFIX,cdn.office.net,subnet-microsoft
DOMAIN,graph.windows.net,subnet-microsoft
DOMAIN,graph.microsoft.com,subnet-microsoft
DOMAIN,hosting.portal.azure.net,subnet-microsoft
DOMAIN,management.azure.com,subnet-microsoft
DOMAIN-SUFFIX,servicebus.windows.net,subnet-microsoft