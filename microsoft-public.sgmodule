#!name=Microsoft Public Firewall
#!desc=Allow major Microsoft services and cloud platforms; excludes user-hosted endpoints.
#!system=ios
#!author=Codex

[Rule]
DOMAIN,account.microsoft.com,DIRECT
DOMAIN,login.microsoftonline.com,DIRECT
DOMAIN,login.microsoft.com,DIRECT
DOMAIN,login.windows.net,DIRECT
DOMAIN,login.live.com,DIRECT
DOMAIN-SUFFIX,microsoftonline.com,DIRECT
DOMAIN-SUFFIX,msauth.net,DIRECT
DOMAIN-SUFFIX,msauthimages.net,DIRECT
DOMAIN-SUFFIX,msftauth.net,DIRECT
DOMAIN-SUFFIX,msftauthimages.net,DIRECT
DOMAIN-SUFFIX,aadcdn.microsoftonline-p.com,DIRECT
DOMAIN-SUFFIX,microsoft.com,DIRECT
DOMAIN-SUFFIX,windows.com,DIRECT
DOMAIN-SUFFIX,office.com,DIRECT
DOMAIN-SUFFIX,office365.com,DIRECT
DOMAIN-SUFFIX,outlook.com,DIRECT
DOMAIN-SUFFIX,live.com,DIRECT
DOMAIN-SUFFIX,microsoftstore.com,DIRECT
DOMAIN-SUFFIX,skype.com,DIRECT
DOMAIN-SUFFIX,xbox.com,DIRECT
DOMAIN-SUFFIX,xboxlive.com,DIRECT
DOMAIN-SUFFIX,bing.com,DIRECT
DOMAIN-SUFFIX,bing.net,DIRECT
DOMAIN-SUFFIX,msn.com,DIRECT
DOMAIN-SUFFIX,surface.com,DIRECT
DOMAIN,docs.microsoft.com,DIRECT
DOMAIN,learn.microsoft.com,DIRECT
DOMAIN,support.microsoft.com,DIRECT
DOMAIN-SUFFIX,windowsupdate.com,DIRECT
DOMAIN,update.microsoft.com,DIRECT
DOMAIN-SUFFIX,microsoftupdate.com,DIRECT
DOMAIN,download.microsoft.com,DIRECT
DOMAIN,download.windowsupdate.com,DIRECT
DOMAIN,officecdn.microsoft.com,DIRECT
DOMAIN-SUFFIX,azure.com,DIRECT
DOMAIN,portal.azure.com,DIRECT
DOMAIN,management.azure.com,DIRECT
